<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.gateguard.dnslock"
    android:versionCode="1"
    android:versionName="1.0" >

    <uses-sdk
        android:minSdkVersion="24"
        android:targetSdkVersion="35" />

    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WRITE_SETTINGS" />
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS" />
    <!-- Needed to detect which app is actually on screen when a reward expires -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS" />
    <!-- Needed to terminate the open app after sending it to the background -->
    <uses-permission android:name="android.permission.KILL_BACKGROUND_PROCESSES" />

    <application
        android:allowBackup="false"
        android:debuggable="true"
        android:extractNativeLibs="false"
        android:icon="@drawable/ic_shield"
        android:label="System DNS"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Black.NoTitleBar" >

        <!-- Hidden launcher - app won't show in app drawer -->
        <activity
            android:name="com.gateguard.dnslock.SetupActivity"
            android:exported="true"
            android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen" >
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- PIN Guard - blocks Device Admin removal without correct PIN -->
        <activity
            android:name="com.gateguard.dnslock.PinGuardActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:showWhenLocked="true"
            android:theme="@android:style/Theme.NoTitleBar"
            android:turnScreenOn="true" />

        <!-- Device Admin Receiver - prevents uninstallation -->
        <receiver
            android:name="com.gateguard.dnslock.GateDeviceAdmin"
            android:exported="true"
            android:permission="android.permission.BIND_DEVICE_ADMIN" >
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin_policies" />

            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>

        <!-- DNS Lock Service - runs forever in background -->
        <service
            android:name="com.gateguard.dnslock.DNSLockService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="specialUse" >
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="DNS enforcement for parental control" />
        </service>

        <!-- Watchdog Receiver - AlarmManager-based, survives force-stop -->
        <receiver
            android:name="com.gateguard.dnslock.WatchdogReceiver"
            android:enabled="true"
            android:exported="false" >
            <intent-filter>
                <action android:name="com.gateguard.dnslock.WATCHDOG" />
            </intent-filter>
        </receiver>

        <!-- Boot Receiver - starts service on phone restart -->
        <receiver
            android:name="com.gateguard.dnslock.BootReceiver"
            android:enabled="true"
            android:exported="true" >
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- Accessibility Service - UNKILLABLE DNS Guardian -->
        <service
            android:name="com.gateguard.dnslock.DNSAccessibilityService"
            android:exported="true"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE" >
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>

            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_config" />
        </service>
    </application>

</manifest>